# Local compose containers. Set AWS_SSH_HOST to also inspect a Lightsail Docker Engine over SSH.
OPS_CONTAINER_SCOPE=name
OPS_NAME_PREFIXES=simpleword-
AWS_SSH_HOST=

# Cloud panels (optional).
GCP_PROJECT=
GCP_REGION=asia-northeast3
GCP_BILLING_TABLE=
USD_KRW=1350

# Local diagnostics and package inventory.
OPS_DASHBOARD_PORT=9760
OPS_DASHBOARD_HOST=127.0.0.1
OPS_DASHBOARD_POLL_MS=5000
OPS_PYTHON=.venv/bin/python
OPS_ACTION_AUDIT_FILE=./.ops-data/action-audit.jsonl
OPS_DIAGNOSTICS_DIR=./.ops-data/reports
OPS_LOG_ARCHIVE_DIR=./.ops-data/logs

# Lightsail has no autoscaling. Local scale actions stay disabled until reviewed explicitly.
OPS_SCALE_SERVICE=
OPS_SCALE_ALLOWED_SERVICES=
