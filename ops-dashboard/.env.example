# Host alias from ~/.ssh/config for the AWS Lightsail instance
AWS_SSH_HOST=

# gcloud CLI identity/project and Cloud Run location
GCP_PROJECT=
GCP_REGION=asia-northeast3
# Optional: project.dataset.table with Cloud Billing export enabled
GCP_BILLING_TABLE=

# Dashboard stays bound to 127.0.0.1
OPS_DASHBOARD_PORT=9760
OPS_DASHBOARD_POLL_MS=30000
USD_KRW=1350
