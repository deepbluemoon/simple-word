resolver 127.0.0.11 ipv6=off valid=5s;

limit_req_zone $binary_remote_addr zone=simplify_per_ip:10m rate=${NGINX_SIMPLIFY_RATE};
limit_req_zone $binary_remote_addr zone=feedback_per_ip:10m rate=${NGINX_FEEDBACK_RATE};
limit_conn_zone $binary_remote_addr zone=connections_per_ip:10m;
set_real_ip_from 10.203.0.254/32;
real_ip_header X-Forwarded-For;
real_ip_recursive on;

upstream api_backend {
    zone api_backend 64k;
    server api-1:8000 resolve max_fails=2 fail_timeout=5s;
    server api-2:8000 resolve max_fails=2 fail_timeout=5s;
}

server {
    listen 80;
    server_name ${NGINX_SERVER_NAME};
    server_tokens off;
    client_max_body_size 6m;
    client_body_timeout 15s;
    send_timeout 30s;
    limit_conn connections_per_ip ${NGINX_CONNECTIONS_PER_IP};
    limit_conn_status 429;
    error_page 429 = @rate_limited;

    add_header Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; connect-src 'self' https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; font-src 'self' https://cdn.jsdelivr.net" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    include /etc/nginx/conf.d/snippets/simple-word-routes.conf;
}
